{
  "name": "neo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Native macOS Tauri 2 app for running up to 20 Claude Code (or shell) sessions in parallel — frosted glass + auto-tiled panes with drag-to-reorder and resizable gutters.",
  "license": "MIT",
  "author": "Steven Junop <stevenjunop@gmail.com>",
  "homepage": "https://github.com/Steviewonders99/neo",
  "repository": {
    "type": "git",
    "url": "https://github.com/Steviewonders99/neo.git"
  },
  "bugs": {
    "url": "https://github.com/Steviewonders99/neo/issues"
  },
  "keywords": [
    "tauri",
    "macos",
    "terminal",
    "claude-code",
    "multiplexer",
    "xterm",
    "rust",
    "react"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^14.0.0",
    "xterm": "^5.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.8"
  }
}
